@startuml
title Диаграмма деятельности: работа приложения
start
:Main создаёт Config\n(размер, число воды и ловушек,\nнаграды, γ, α);
:Environment: сгенерировать лабиринт\n(MazeGenerator, поиск в глубину);
:Расставить сыр, воду и ловушки,\nмышь - в правом нижнем углу;
:Создать Policy: Q[height][width][4] = 0\nи Agent в стартовой клетке;
:Показать окно MazeTrainerFrame;

repeat
  :Пользователь выбирает команду;
  switch (Команда?)
  case (Обучить)
    partition "learn(N)" {
      repeat
        partition "Эпоха: runAge(2000)" {
          repeat
            :Определить доступные действия\n(соседние клетки - не стены);
            if (Есть доступные действия?) then (да)
              :Выбрать действие: с вероятностью 0.9 -\nmax Q(s,a), иначе случайное (ε = 0.1);
              :Вычислить новое состояние s' = s + (dr, dc);
              :Получить награду по типу клетки s'\n(вода, ток, сыр, пусто);
              :Переместить мышь,\nотметить клетку посещённой;
              :Q(s,a) += α·(r + γ·max Q(s',·) - Q(s,a));
            else (нет)
              :Эпоха прервана;
            endif
          repeat while (Есть ход, сыр не достигнут\nи шагов меньше 2000?) is (да) not (нет)
          :Счётчик эпох++;
          :Сбросить среду: мышь на старт,\nлабиринт восстановлен;
        }
      repeat while (Выполнено меньше N эпох?) is (да) not (нет)
    }
  case (Демо)
    repeat
      :Выполнить шаг среды\n(выбор действия, награда, обновление Q);
      :Перерисовать лабиринт;
      :Пауза 150 мс;
    repeat while (Не остановлено, сыр не достигнут\nи шагов меньше 2000?) is (да) not (нет)
  case (Сбросить политику)
    :Создать новую Policy (Q = 0), счётчик эпох = 0;
    :Восстановить лабиринт, мышь на старт;
  case (Новый лабиринт)
    :Сгенерировать новый лабиринт;
    :Мышь на старт, очистить посещённые клетки;
  endswitch
  :Перерисовать лабиринт (MazePanel),\nобновить число пройденных эпох;
repeat while (Окно открыто?) is (да) not (нет)
stop
@enduml
